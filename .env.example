# Google Gemini API 密钥（在 https://aistudio.google.com/ 获取）
GEMINI_API_KEY=your_gemini_api_key_here

# 模型 ID：默认 gemini-4-argon；如需免费额度可改 gemini-3.8-flash；如有内测权限可填 gemini-4-hydrogen
GEMINI_MODEL=gemini-4-argon

# 本地 Obsidian 仓库路径（留空则默认输出到本项目的 ./vault 目录，可直接用 Obsidian 打开）
OBSIDIAN_VAULT_PATH=

# 每次精选的热点数量（默认 3）
TOP_K_TOPICS=3
